modules = ["web", "vue-node-20", "python-3.12", "bash", "nodejs-24"]
run = "GEV_ALLOWED_HOSTS=\"${REPLIT_DEV_DOMAIN},${REPLIT_DOMAINS},${GEV_ALLOWED_HOSTS}\" npm run dev"
onBoot = "npm ci"

[env]
HOST = "0.0.0.0"
PORT = "5000"
# Momenta Technologies theme (build/momentaTheme.js). Remove for upstream look.
GEV_THEME = "momenta"
# Puppeteer is only used by the QA scripts; skip its Chromium download.
PUPPETEER_SKIP_DOWNLOAD = "1"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
# Reserved VM, not Autoscale: the server keeps in-memory caches, rate-limit
# buckets and long-lived upstream sockets that cold starts would discard.
deploymentTarget = "vm"
build = ["npm", "ci"]
run = ["sh", "-c", "GEV_ALLOWED_HOSTS=\"${REPLIT_DOMAINS},${GEV_ALLOWED_HOSTS}\" npm run dev"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "GEV_ALLOWED_HOSTS=\"${REPLIT_DEV_DOMAIN},${REPLIT_DOMAINS},${GEV_ALLOWED_HOSTS}\" npm run dev -- --host 0.0.0.0 --port 5000 --strictPort"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
