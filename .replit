# Replit config.
#
# Workspace (Run button): the Vite dev server, with hot reload, for editing.
# Deployment: a production build served by `vite preview`. Every API proxy
# runs there too (configurePreviewServer), and build/productionServing.js adds
# precompressed assets + immutable caching. Measured on a cold first load:
# dev 12.3 s / 1,555 requests / 90 MB  ->  production 3.7 s / 52 requests / 8.5 MB.
#
# GEV_ALLOWED_HOSTS is required: the server only answers Host headers it
# trusts. REPLIT_DEV_DOMAIN is the workspace webview host; REPLIT_DOMAINS is the
# comma-separated list of deployment hosts (*.replit.app plus custom domains).
# Empty entries are ignored by build/allowedHosts.js.
#
# API keys go in Replit Secrets, never in a committed .env. Provider Settings
# (POWER UP) refuses proxied requests by design, so it cannot save keys here.
# GOOGLE_MAPS_API_KEY and CESIUM_ION_TOKEN are compiled into the client bundle,
# so they must exist as Secrets BEFORE the deployment builds.

modules = ["nodejs-24"]
run = "GEV_ALLOWED_HOSTS=\"${REPLIT_DEV_DOMAIN},${REPLIT_DOMAINS},${GEV_ALLOWED_HOSTS}\" npm run dev"
onBoot = "npm ci"

[env]
HOST = "0.0.0.0"
PORT = "5000"
# Momenta Technologies theme (build/momentaTheme.js). Remove for upstream look.
GEV_THEME = "momenta"
# Puppeteer is only used by the QA scripts; skip its Chromium download.
PUPPETEER_SKIP_DOWNLOAD = "1"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
# Reserved VM, not Autoscale: the server keeps in-memory caches, rate-limit
# buckets and long-lived upstream sockets that cold starts would discard.
deploymentTarget = "vm"
# Env is set inline so the deployment does not depend on [env] being applied.
build = ["sh", "-c", "PUPPETEER_SKIP_DOWNLOAD=1 npm ci && GEV_THEME=momenta npm run build"]
run = ["sh", "-c", "HOST=0.0.0.0 PORT=5000 GEV_THEME=momenta GEV_ALLOWED_HOSTS=\"${REPLIT_DOMAINS},${GEV_ALLOWED_HOSTS}\" npx vite preview"]
